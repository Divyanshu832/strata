# Copy to .env and fill in. Never commit .env.

# Postgres (Supabase). Needs the pgvector extension.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/strata

# Models (Anthropic)
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-haiku-5-5
RECONCILE_MODEL=claude-sonnet-5-5

# Embeddings: openai | voyage
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
VOYAGE_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Optional reranker: none | voyage | cohere
RERANKER=none
COHERE_API_KEY=

# API server
PORT=8787
# Shared secret for admin routes (creating workspaces and API keys)
STRATA_ADMIN_TOKEN=

# Clients (MCP server, SDK, web app)
STRATA_URL=http://localhost:8787
STRATA_API_KEY=
