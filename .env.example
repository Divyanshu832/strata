# Copy to .env and fill in. Never commit .env.
# Defaults are fully local and free: Postgres on this Mac + Ollama. No paid service is needed.

# Local Postgres with pgvector (Postgres.app includes it). Create the db once: createdb strata
DATABASE_URL=postgres://localhost:5432/strata

# Models: ollama (local, free) | anthropic (optional, paid)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
EXTRACT_MODEL=qwen3:8b
ANSWER_MODEL=qwen3:8b
ANTHROPIC_API_KEY=

# Embeddings: ollama (local, free) | openai (optional, paid). Size must stay 768 (see migration).
EMBEDDINGS_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OPENAI_API_KEY=

# Optional reranker: none (default) | cohere (paid)
RERANKER=none
COHERE_API_KEY=

# API server
PORT=8787
# Secret for admin routes (creating workspaces and API keys). Any long random string.
STRATA_ADMIN_TOKEN=

# Clients (MCP server, web app)
STRATA_URL=http://localhost:8787
STRATA_API_KEY=
