# Copy to .env and fill in. Never commit .env.
# Defaults are local and free: Postgres on this machine, embeddings inside the server, no LLM.
# Your agent (Claude Code, any MCP client) extracts facts itself and sends them to Strata.

# Local Postgres with pgvector (Postgres.app includes it). Create the db once: createdb strata
DATABASE_URL=postgres://localhost:5432/strata

# Optional Strata extractor, for raw text with no agent behind it (imports, plain webhooks).
# none (default) | openrouter. Also enables POST /v1/answer.
EXTRACTOR=none
OPENROUTER_API_KEY=
EXTRACTOR_MODEL=z-ai/glm-5.3
ANSWER_MODEL=z-ai/glm-5.3

# Local embedding model, downloaded once on first use (~35 MB). Size must stay 384 (see migration).
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIM=384

# API server
PORT=8787
# Secret for admin routes (creating workspaces and API keys). Any long random string.
STRATA_ADMIN_TOKEN=

# Clients (MCP server, web app)
STRATA_URL=http://localhost:8787
STRATA_API_KEY=
